// Shared iOS signing defaults for local development + CI.
#include "../build/Version.xcconfig"

NODOASSIST_IOS_DEFAULT_TEAM = FWJYW4S8P8
NODOASSIST_IOS_SELECTED_TEAM = $(NODOASSIST_IOS_DEFAULT_TEAM)
NODOASSIST_DEVELOPMENT_TEAM = $(NODOASSIST_IOS_SELECTED_TEAM)
NODOASSIST_CODE_SIGN_STYLE = Automatic
NODOASSIST_CODE_SIGN_IDENTITY = Apple Development
NODOASSIST_CODE_SIGN_ENTITLEMENTS = Sources/NodoAssist.entitlements
NODOASSIST_APP_BUNDLE_ID = ai.nodoassistfoundation.app
NODOASSIST_APP_GROUP_ID = group.ai.nodoassistfoundation.app.shared
NODOASSIST_WATCH_APP_BUNDLE_ID = ai.nodoassistfoundation.app.watchkitapp
NODOASSIST_ACTIVITY_WIDGET_BUNDLE_ID = ai.nodoassistfoundation.app.activitywidget
NODOASSIST_ACTIVITY_WIDGET_PROFILE =
NODOASSIST_WATCH_APP_PROFILE =

// Local contributors can override this by running scripts/ios-configure-signing.sh.
// Keep include after defaults: xcconfig is evaluated top-to-bottom.
#include? "../.local-signing.xcconfig"
#include? "../LocalSigning.xcconfig"

// Debug products install alongside release products and keep their app-group data separate.
NODOASSIST_DEBUG_APP_BUNDLE_ID = $(NODOASSIST_APP_BUNDLE_ID).debug
NODOASSIST_DEBUG_ACTIVITY_WIDGET_BUNDLE_ID = $(NODOASSIST_DEBUG_APP_BUNDLE_ID).activitywidget
NODOASSIST_DEBUG_WATCH_APP_BUNDLE_ID = $(NODOASSIST_DEBUG_APP_BUNDLE_ID).watchkitapp
NODOASSIST_DEBUG_APP_GROUP_ID = $(NODOASSIST_APP_GROUP_ID).debug

CODE_SIGN_STYLE = $(NODOASSIST_CODE_SIGN_STYLE)
CODE_SIGN_IDENTITY = $(NODOASSIST_CODE_SIGN_IDENTITY)
DEVELOPMENT_TEAM = $(NODOASSIST_DEVELOPMENT_TEAM)

// Let Xcode manage provisioning for the selected local team unless a local override pins one.
PROVISIONING_PROFILE_SPECIFIER =
