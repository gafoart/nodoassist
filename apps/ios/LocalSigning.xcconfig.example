// Copy to LocalSigning.xcconfig for personal local signing overrides.
// This file is only an example and should stay committed.

NODOASSIST_CODE_SIGN_STYLE = Automatic
NODOASSIST_CODE_SIGN_IDENTITY = Apple Development
NODOASSIST_DEVELOPMENT_TEAM = YOUR_TEAM_ID

NODOASSIST_APP_BUNDLE_ID = ai.nodoassistfoundation.app
NODOASSIST_SHARE_BUNDLE_ID = ai.nodoassistfoundation.app.share
NODOASSIST_APP_GROUP_ID = group.ai.nodoassistfoundation.app.shared
NODOASSIST_ACTIVITY_WIDGET_BUNDLE_ID = ai.nodoassistfoundation.app.activitywidget
NODOASSIST_WATCH_APP_BUNDLE_ID = ai.nodoassistfoundation.app.watchkitapp

// Leave empty with automatic signing.
NODOASSIST_APP_PROFILE =
NODOASSIST_SHARE_PROFILE =
NODOASSIST_ACTIVITY_WIDGET_PROFILE =
NODOASSIST_WATCH_APP_PROFILE =
